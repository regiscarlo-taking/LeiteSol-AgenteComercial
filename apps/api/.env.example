LEITESOL_API_SERVICE_NAME=leitesol-api
LEITESOL_API_API_VERSION=v1
LEITESOL_API_ENVIRONMENT=development
LEITESOL_API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
LEITESOL_API_ALLOWED_HOSTS=localhost,127.0.0.1,api
LEITESOL_API_API_KEY=
# Optional gateway request/response metadata in the configured Blob container.
LEITESOL_API_GATEWAY_LOG_TO_BLOB=false
# Histórico de conversas no schema IA_APP do Warehouse (sql 17_historico_conversa.sql).
# Só ligue depois de criar as tabelas e definir a retenção.
LEITESOL_API_CONVERSATION_HISTORY_ENABLED=false
