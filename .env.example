# Power BI URL and identifiers from the browser. Keep real values in local .env only.
LEITESOL_API_FABRIC_POWERBI_URL=<complete-private-powerbi-url>
LEITESOL_API_FABRIC_WORKSPACE_ID=<workspace-id-from-url>
LEITESOL_API_FABRIC_WAREHOUSE_ID=<warehouse-id-from-url>

# This is the SQL endpoint copied from Fabric, not the browser URL above.
LEITESOL_API_FABRIC_SERVER=<fabric-sql-endpoint>
LEITESOL_API_FABRIC_DATABASE=AgenteFaturamentoDW
LEITESOL_API_FABRIC_DRIVER=ODBC Driver 18 for SQL Server
LEITESOL_API_FABRIC_CONNECTION_TIMEOUT=10

# Microsoft Entra ID app registration. Keep the secret only in local .env/Key Vault.
LEITESOL_API_ENTRA_TENANT_ID=<tenant-id>
LEITESOL_API_ENTRA_CLIENT_ID=<application-client-id>
LEITESOL_API_ENTRA_CLIENT_SECRET=<client-secret>