# Power BI URL and identifiers from the browser. Keep real values in local .env only.
LEITESOL_API_FABRIC_POWERBI_URL=<complete-private-powerbi-url>
LEITESOL_API_FABRIC_WORKSPACE_ID=<workspace-id-from-url>
LEITESOL_API_FABRIC_WAREHOUSE_ID=<warehouse-id-from-url>

# This is the SQL endpoint copied from Fabric, not the browser URL above.
LEITESOL_API_FABRIC_SERVER=<fabric-sql-endpoint>
LEITESOL_API_FABRIC_DATABASE=AgenteFaturamentoDW
LEITESOL_API_FABRIC_AUTHENTICATION=ActiveDirectoryServicePrincipal
LEITESOL_API_FABRIC_DRIVER=ODBC Driver 18 for SQL Server
LEITESOL_API_FABRIC_CONNECTION_TIMEOUT=10

# Microsoft Entra ID app registration. Keep the secret only in local .env/Key Vault.
LEITESOL_API_ENTRA_TENANT_ID=<tenant-id>
LEITESOL_API_ENTRA_CLIENT_ID=<application-client-id>
LEITESOL_API_ENTRA_CLIENT_SECRET=<client-secret>

# Azure Key Vault and Blob Storage. Keep secrets in Azure, not in this file.
LEITESOL_API_KEY_VAULT_URL=https://kv-comercial-ia.vault.azure.net/
LEITESOL_API_GEMINI_API_KEY_SECRET_NAME=GEMINI-API-KEY
LEITESOL_API_GEMINI_API_KEY=<local-only-development-key>
LEITESOL_API_GEMINI_MODEL=gemini-2.5-flash
LEITESOL_API_STORAGE_ACCOUNT_URL=https://<storage-account-name>.blob.core.windows.net/
LEITESOL_API_STORAGE_CONTAINER_NAME=<container-name>
LEITESOL_API_STORAGE_BLOB_PREFIX=

# User authentication. Outside development the API only accepts Entra ID v2
# access tokens issued to this API (audience below); the user's e-mail decides
# the commercial scope (IA_COMUM.RLS_USUARIO_EQUIPE).
LEITESOL_API_AUTH_MODE=local
LEITESOL_API_ENTRA_API_AUDIENCE=api://<application-client-id>
# Entra ID group object ids that see everything (board + sales admin).
LEITESOL_API_ENTRA_FULL_ACCESS_GROUP_IDS=<group-object-id>

# Local development authentication (JWT) - development only.
# LOCAL_USER_EMAIL simulates a scoped user; FULL_ACCESS=true sees everything.
LEITESOL_API_LOCAL_USER_EMAIL=
LEITESOL_API_LOCAL_USER_FULL_ACCESS=true
LEITESOL_API_BASIC_AUTH_USERNAME=admin
LEITESOL_API_BASIC_AUTH_PASSWORD=<bcrypt-hash-of-password>
LEITESOL_API_JWT_SECRET_KEY=<change-in-production>
LEITESOL_API_JWT_EXPIRATION_HOURS=24
LEITESOL_API_JWT_REFRESH_EXPIRATION_HOURS=168

# Environment: development | staging | production
LEITESOL_API_ENVIRONMENT=development
